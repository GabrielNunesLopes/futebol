--!strict

return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Shared = ReplicatedStorage:WaitForChild("Shared")
	local MatchState = require(Shared.Match.MatchState)
	local MatchConfig = require(Shared.Config.MatchConfig)

	describe("MatchState", function()
		it("transitions countdown to playing", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			expect(match.State).to.equal("Playing")
		end)

		it("goes goal pause then countdown", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			expect(match:goal("Blue")).to.equal(true)
			expect(match.State).to.equal("GoalPause")
			match:tick(MatchConfig.GoalPauseSeconds)
			expect(match.State).to.equal("Countdown")
		end)

		it("enters overtime when regulation ends tied", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			match:tick(MatchConfig.RegulationSeconds)
			expect(match.State).to.equal("Countdown")
			expect(match.Overtime).to.equal(true)
			match:tick(MatchConfig.CountdownSeconds)
			expect(match.State).to.equal("Overtime")
		end)

		it("finishes on an overtime goal", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			match:tick(MatchConfig.RegulationSeconds)
			match:tick(MatchConfig.CountdownSeconds)
			match:goal("Red")
			expect(match.State).to.equal("Finished")
			expect(match.Winner).to.equal("Red")
		end)

		it("finishes regulation with a non-tied score", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			match:goal("Blue")
			match:tick(MatchConfig.GoalPauseSeconds)
			match:tick(MatchConfig.CountdownSeconds)
			match:tick(MatchConfig.RegulationSeconds)
			expect(match.State).to.equal("Finished")
			expect(match.Winner).to.equal("Blue")
		end)

		it("returns to waiting after the result screen timeout", function()
			local match = MatchState.new()
			match:start()
			match:tick(MatchConfig.CountdownSeconds)
			match:goal("Blue")
			match:tick(MatchConfig.GoalPauseSeconds)
			match:tick(MatchConfig.CountdownSeconds)
			match:tick(MatchConfig.RegulationSeconds)
			expect(match.State).to.equal("Finished")
			match:tick(MatchConfig.ResultSeconds)
			expect(match.State).to.equal("Waiting")
		end)
	end)
end
